! ~/.Xresources -- loaded by ~/.xprofile via `xrdb -merge`
!
! Scope: X server-wide font/cursor scaling only. Terminal config lives in
! ~/.config/alacritty/. The old xterm-era config is kept in .Xresources.old.

! ---- DPI ----
! X exposes a single DPI for the whole screen, derived from the combined
! multi-monitor geometry -- which gives a meaningless 96. Pin it instead.
! Real densities: eDP-1 (1920x1200 / 366mm) ~133, Dell U2725QE
! (3840x2160 / 597mm) ~163. 144 splits the difference; raise toward 163 if
! working mostly docked.
!
! Consumers: dwm + dmenu (Xft at client startup), GTK apps, and Alacritty
! (winit reads Xft.dpi for its X11 scale factor). Changes need a client
! restart -- for the dwm bar, a full dwm restart.
Xft.dpi: 144

! ---- Font rendering ----
Xft.antialias: true
Xft.hinting: true
Xft.hintstyle: hintslight
Xft.rgba: rgb
Xft.lcdfilter: lcddefault

! ---- Cursor ----
! Cursor size is not DPI-derived, so it stays tiny on the 4K panel unless
! scaled by hand. 24 is the default; 32 tracks 144 DPI.
Xcursor.theme: Adwaita
Xcursor.size: 32
