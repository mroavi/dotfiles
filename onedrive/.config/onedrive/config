# Sync root directory
sync_dir = "~/OneDrive"

# Do not treat skip_dir as strict full path matches
skip_dir_strict_match = "false"

# skip_dir and skip_file can be repeated; all lines are combined.
# After changing them, run: onedrive --resync --sync

# Client defaults (temp, lock and partial download files)
skip_file = "~*|.~*|*.tmp|*.partial"

# General build output
skip_dir = "build|out"

# Git
skip_dir = ".git"

# LaTeX
skip_dir = "aux"

# C# / .NET / Visual Studio
skip_dir = "bin|obj|.vs"
skip_file = "*.user|*.suo"

# Java (Maven, Gradle)
skip_dir = "target|.gradle"
skip_file = "*.class|*.jar"

# C / C++ (CMake, clangd)
skip_dir = ".cache"
skip_file = "compile_commands.json"

# Python
skip_dir = "__pycache__|venv"

# Node.js
skip_dir = "node_modules"

# PlatformIO
skip_dir = ".pio"

# KiCad (local history and restore backups)
skip_dir = ".history|_restore_backup_*"

# Vim
skip_file = "*.swp|.*.swo"

# JetBrains IDEs
skip_dir = ".idea"

# VS Code
skip_dir = ".vscode"
